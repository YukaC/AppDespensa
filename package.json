{
  "name": "app-despensa-fernando",
  "private": true,
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix client",
    "dev": "npx concurrently -k -n server,client -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "build:client": "npm run build --prefix client",
    "db:push": "npm run db:push --prefix server",
    "db:seed": "npm run db:seed --prefix server",
    "start:prod": "pm2 start ecosystem.config.cjs",
    "tunnel": "./tunnel.sh",
    "e2e:a11y": "node scripts/e2e-a11y.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4"
  }
}
