    "db:migrate": "prisma migrate dev",
    "db:seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "prisma": "^6.3.0"
  },
  "overrides": {
    "qs": "6.16.0",
    "body-parser": "1.20.6"
  }
}
