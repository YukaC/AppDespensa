{
  "name": "despensa-fernando-server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "prisma generate && node --watch src/index.js",
    "start": "prisma generate && node src/index.js",
